{
  "name": "@agentry/workbench-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Agentry Workbench web half \u2014 a React + Vite SPA that `vite build`s into the committed plugin payload at plugin/workbench/web/ (the server static-serves it). Phase 0 is a placeholder shell proving the Vite artifact + dist-lockstep (ADR-003); the real router/sidebar/tabs land in Phase 1.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"import('../../../scripts/lib/src-hash.mjs').then(({writeStamp})=>writeStamp('../../../plugin/workbench/web/.srchash','..',{srcSubdir:'web/src',skipWorkspaceDeps:true}))\"",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/test/**/*.test.ts'"
  },
  "dependencies": {
    "@agentry/workbench-shared": "workspace:*",
    "@codemirror/lang-markdown": "^6.5.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@uiw/react-codemirror": "^4.25.12",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
