{
  "name": "@agentry/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentry's public site: a static Astro landing page plus the /docs area. Deployed on Vercel, never published; nothing imports it.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "metrics": "node scripts/load-metrics.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
