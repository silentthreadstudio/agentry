---
// The landing page: pure composition of the section components, in the approved order.
import Agents from "../components/Agents.astro";
import BoardView from "../components/BoardView.astro";
import Day from "../components/Day.astro";
import Extensible from "../components/Extensible.astro";
import FieldLog from "../components/FieldLog.astro";
import Guardrails from "../components/Guardrails.astro";
import Harness from "../components/Harness.astro";
import Hero from "../components/Hero.astro";
import Install from "../components/Install.astro";
import Lanes from "../components/Lanes.astro";
import Memory from "../components/Memory.astro";
import Scriptable from "../components/Scriptable.astro";
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/base.ts";
import { softwareApplication, webSite } from "../lib/jsonld.ts";

const home = new URL(withBase(""), Astro.site).href;
---

<Base
  title="Agentry · the harness around Claude Code"
  jsonLd={[softwareApplication(home), webSite(home)]}
>
  <Hero />
  <Harness />
  <Lanes />
  <Agents />
  <Extensible />
  <Scriptable />
  <Day />
  <BoardView />
  <Memory />
  <Guardrails />
  <FieldLog />
  <Install />
</Base>
