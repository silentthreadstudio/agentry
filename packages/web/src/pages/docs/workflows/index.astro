// /docs/workflows — what .agentry/process.json, .agentry/workflow.json and .agentry/config.json
// control, key by key, with each default, read from the loaders (plugin/scripts/lib/process/spec/*,
// read.mjs, lib/config.mjs, the memory config reader). Every key in a `<th scope="row"><code>` cell
// is checked against the loader source by the docs key check; keep that cell form for key rows.
// The solo example is imported raw from examples/workflows/, so the page shows the file as it ships.
import soloJson from "../../../../../../examples/workflows/solo-fast/workflow.json?raw";
import DocsLayout from "../../../layouts/docs-layout/DocsLayout.astro";
