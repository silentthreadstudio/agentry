---
// /docs/capabilities — the Capabilities hub: what Agentry does, each item linking to its page
// where one exists. Facts match the landing page.
import DocsLayout from "../../../layouts/docs-layout/DocsLayout.astro";
import { withBase } from "../../../lib/base.ts";
---

<DocsLayout
  current="capabilities"
  title="Capabilities"
  description="What Agentry does: right-sized routing, specialist agents, your board run as verified lanes, a local memory, approvals you stay in control of, and one scriptable CLI."
  eyebrow="Capabilities · Overview"
  lede="What Agentry does for a task, from the front door to the merge. Each item links to its own page where there is one."
>
  <div class="prose">
    <table class="layers" aria-label="Agentry's capabilities">
      <thead>
        <tr>
          <th scope="col">Capability</th>
          <th scope="col">What it does</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Right-sized routing</th>
          <td><code>/agentry:go</code> reads the task and picks its shape: one-shot, spec-first, or decompose + verify. You approve at every fork.</td>
        </tr>
        <tr>
          <th scope="row">Specialist agents</th>
          <td>Nine roles, one job each. The builder never checks its own work; an independent verifier does.</td>
        </tr>
        <tr>
          <th scope="row">Lanes</th>
          <td><code>/agentry:exec</code> runs a pre-planned task in its own worktree through build, verify and your gate; <code>/agentry:merge</code> lands it.</td>
        </tr>
        <tr>
          <th scope="row"><a href={withBase("docs/memory/")}>Memory</a></th>
          <td>A local store of decisions, gotchas and repo facts, recalled when a task needs them.</td>
        </tr>
        <tr>
          <th scope="row"><a href={withBase("docs/permissions/")}>Permissions</a></th>
          <td>Outward and irreversible actions wait for your approval.</td>
        </tr>
        <tr>
          <th scope="row">One CLI</th>
          <td><code>agentry board</code>, <code>agentry lane</code> and <code>agentry draft</code>: writes preview until <code>--apply</code>, and every command takes <code>--json</code>.</td>
        </tr>
      </tbody>
    </table>
  </div>
</DocsLayout>
