---
// Base.astro — the chrome every page shares: the full <head> (meta, Open Graph, fonts,
// favicon), the skip link, the site Nav and Footer, and Vercel Analytics + Speed Insights
// (no-ops outside Vercel). Pages fill the <main> slot.
//
// Base-path rule: Astro does not prefix hand-written URLs. Internal hrefs/srcs go through
// withBase(); absolute URLs for canonical/OG are built from the configured `site`.
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { withBase } from "../lib/base.ts";
import { type JsonLd, serialise } from "../lib/jsonld.ts";
import { SITE_DESCRIPTION, SITE_NAME, THEME_COLOR, iconQuery } from "../lib/site.ts";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  /** <title> + OG/Twitter title. */
  title: string;
  /** Meta description + OG/Twitter description. */
  description?: string;
  /** Keep the page out of search results and drop its canonical (the 404 page). */
  noindex?: boolean;
  /** schema.org data, one inline JSON-LD script per entry. */
  jsonLd?: JsonLd[];
}

const { title, noindex = false, description = SITE_DESCRIPTION, jsonLd = [] } = Astro.props;

const site = import.meta.env.SITE ?? "";
const canonical = site ? new URL(Astro.url.pathname, site).href : Astro.url.pathname;
const ogImage = site ? new URL(withBase("og.png"), site).href : withBase("og.png");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={withBase("favicon.ico") + iconQuery} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg") + iconQuery} sizes="any" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png") + iconQuery} />
    <link rel="manifest" href={withBase("site.webmanifest")} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,700;12..96,800&family=JetBrains+Mono:wght@400;600&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Agentry: built by one agent, checked by another, merged when green." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content={THEME_COLOR} />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={serialise(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <SpeedInsights />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 10;
    padding: 10px 16px;
    border: var(--border);
    border-radius: var(--radius-m);
    background: var(--surface);
    font-weight: 700;
    text-decoration: none;
  }

  .skip:focus {
    top: 12px;
  }

  main:focus {
    outline: none;
  }
</style>
