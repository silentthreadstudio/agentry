---
// FieldLog.astro — 10 · field log: bugs Agentry found in itself during real night runs,
// and what changed. The project it ran on is not named.
const entries = [
  ["the builder's brief listed symbols as files to own.", "paths only, parsed once, amendable."],
  ["parallel gates failed timing tests under load.", "gates queue; known-flaky tests rerun alone."],
  [
    "the guard froze the conductor's own night notes.",
    "board writes are recorded; listed files may change.",
  ],
];
---

<section id="field" class="band field" aria-labelledby="field-title">
  <div class="wrap section field__inner">
    <div class="field__head">
      <span class="eyebrow">10 · FIELD LOG</span>
      <h2 id="field-title" class="title">Proven on a real game, bugs and all.</h2>
      <p class="field__lede">
        A week of night runs on a game board. Every bug it found in itself is logged and fixed in
        the open.
      </p>
    </div>
    <ul class="entries">
      {
        entries.map(([found, now]) => (
          <li class="entry">
            <span><strong>Found:</strong> {found}</span>
            <span><strong>Now:</strong> {now}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .field {
    background: var(--one);
  }

  .field__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .field__head {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .field__lede {
    font-size: 18px;
    line-height: 1.55;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .entry {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 18px 20px;
    font-size: 16px;
    background: var(--surface);
    border: var(--border);
    border-radius: var(--radius-l);
  }

  .entry span {
    flex: 1 1 320px;
  }
</style>
