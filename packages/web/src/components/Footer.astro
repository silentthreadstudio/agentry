---
// Footer.astro — the closing rule: lab credit and the three outbound links.
import { withBase } from "../lib/base.ts";
---

<footer class="footer">
  <div class="wrap footer__row">
    <span>From the Silent Thread Lab</span>
    <ul class="footer__links">
      <li><a href={withBase("docs/")}>Docs</a></li>
      <li><a href="https://github.com/silentthreadstudio/agentry">GitHub</a></li>
      <li><a href="https://silentthreadstudio.com">Silent Thread <span aria-hidden="true">↗</span></a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--border);
  }

  .footer__row {
    padding-block: 14px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 4px 12px;
    font-size: 14px;
    font-weight: 700;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
</style>
