---
// Install.astro — the three install lines and the requirements.
const lines = [
  "/plugin marketplace add silentthreadstudio/agentry#v0.4.2",
  "/plugin install agentry@agentry-dev",
  "/agentry:init",
];
---

<section id="install" class="wrap install" aria-labelledby="install-title">
  <h2 id="install-title" class="install__title">Three lines. Then your board.</h2>
  <ol class="lines">
    {
      lines.map((line, i) => (
        <li class="line" tabindex="0" aria-label={`Step ${i + 1}: ${line}`}>
          <span class="line__n" aria-hidden="true">{i + 1}</span>
          <code>{line}</code>
        </li>
      ))
    }
  </ol>
  <p class="install__note">Needs Claude Code and Node 24 or newer. MIT. OpenCode is supported in 0.4.0; see the install docs.</p>
</section>

<style>
  .install {
    padding-block: 104px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .install__title {
    font-size: clamp(44px, 6vw, 88px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .lines {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--mono);
    font-size: 15px;
  }

  .line {
    display: flex;
    gap: 18px;
    padding: 16px 18px;
    overflow-x: auto;
    white-space: nowrap;
    background: var(--surface);
    border: var(--border);
    border-radius: var(--radius-m);
  }

  .line__n {
    color: var(--ink-2);
  }

  .install__note {
    font-size: 15px;
    color: var(--ink-2);
  }

  @media (max-width: 600px) {
    .install {
      padding-block: 72px;
    }

    .lines {
      font-size: 14px;
    }
  }
</style>
