---
// Nav.astro — the site header: brand mark home, the section anchors, Docs, GitHub, and the
// Install pill. Anchors are base-aware (`/#sized`) so they also work from the /docs pages.
import { withBase } from "../lib/base.ts";
import Mark from "./Mark.astro";

const home = withBase("");
const docs = withBase("docs/");
const inDocs = Astro.url.pathname.startsWith(docs);
const links = [
  { href: `${home}#sized`, label: "Harness" },
  { href: `${home}#team`, label: "Agents" },
  { href: `${home}#extend`, label: "Extend" },
  { href: `${home}#script`, label: "Script" },
  { href: docs, label: "Docs" },
  { href: "https://github.com/silentthreadstudio/agentry", label: "GitHub" },
];
---

<header>
  <nav aria-label="Main" class="nav">
    <a href={home} class="brand">
      <Mark />
      <span class="brand__name">agentry</span>
    </a>
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.href === docs && inDocs ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={`${home}#install`} class="cta">Install</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .nav {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 22px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
  }

  .brand__name {
    font-weight: 800;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 22px;
    font-size: 16px;
    font-weight: 700;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .links a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--one);
    text-underline-offset: 6px;
  }

  .links .cta {
    padding: 12px 20px;
    border-radius: var(--pill);
    background: var(--ink);
    color: var(--surface);
  }

  .links .cta:hover {
    background: var(--two);
    color: var(--on-two);
  }

  @media (max-width: 600px) {
    .links {
      gap: 0 18px;
    }
  }
</style>
