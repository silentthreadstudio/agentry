---
// Hero.astro — the claim, the one-line pitch, the first install command with a working Copy
// button, and what ships in the box. Numbers here are only what ships: 9 agents, 15 skills,
// 17 board rules.
const command = "/plugin marketplace add silentthreadstudio/agentry";
const inside = ["9 agents", "15 skills", "17 board rules", "local memory server"];
---

<section id="top" class="hero wrap" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero__title">
    Built by one agent. Checked by another. Merged when green.
  </h1>
  <p class="hero__lede">
    Agentry is the harness around Claude Code. It sizes the process to the task, runs your own
    board as verified lanes, remembers what it learned, and every move it makes is a command you
    can script.
  </p>
  <div class="copy" data-copy>
    <code class="copy__cmd" tabindex="0" aria-label="Install command" data-copy-text>{command}</code>
    <button type="button" class="copy__btn" aria-label="Copy install command" data-copy-btn>
      Copy
    </button>
    <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
  </div>
  <ul class="inside" aria-label="What's inside">
    {inside.map((item) => <li>{item}</li>)}
    <li>1 CLI: <span class="inside__mono">agentry</span></li>
  </ul>
</section>

<style>
  .hero {
    padding-block: 72px 56px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero__title {
    max-width: 1150px;
    font-size: clamp(52px, 8vw, 124px);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .hero__lede {
    max-width: 680px;
    font-size: 21px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .copy {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    max-width: 100%;
  }

  .copy__cmd {
    max-width: 100%;
    padding: 15px 18px;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 14px;
    background: var(--surface);
    border: var(--border);
    border-radius: var(--radius-m);
  }

  .copy__btn {
    min-height: 52px;
    min-width: 96px;
    padding: 0 22px;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
    background: var(--one);
    border: var(--border);
    border-radius: var(--radius-m);
    cursor: pointer;
    transition: transform 0.12s ease, background 0.12s ease;
  }

  .copy__btn:hover {
    background: color-mix(in srgb, var(--one) 82%, var(--surface));
  }

  .copy__btn:active {
    transform: translateY(1px);
  }

  .copy__btn[data-state="done"] {
    background: var(--three);
  }

  .inside {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-weight: 700;
    font-size: 15px;
  }

  .inside li {
    padding: 8px 14px;
    background: var(--surface);
    border: var(--border);
    border-radius: var(--pill);
  }

  .inside__mono {
    font-family: var(--mono);
    font-size: 13px;
  }

  @media (max-width: 600px) {
    .hero {
      padding-block: 40px 40px;
    }

    .hero__lede {
      font-size: 19px;
    }
  }
</style>

<script>
  // The Copy button: clipboard API first, a selection-based fallback for insecure origins,
  // a visible "Copied" state and a polite status message for screen readers.
  for (const root of document.querySelectorAll<HTMLElement>("[data-copy]")) {
    const text = root.querySelector<HTMLElement>("[data-copy-text]");
    const button = root.querySelector<HTMLButtonElement>("[data-copy-btn]");
    const status = root.querySelector<HTMLElement>("[data-copy-status]");
    if (!text || !button || !status) continue;
    let timer: number | undefined;

    const fallback = (value: string): boolean => {
      const area = document.createElement("textarea");
      area.value = value;
      area.setAttribute("readonly", "");
      area.style.position = "fixed";
      area.style.opacity = "0";
      document.body.append(area);
      area.select();
      const ok = document.execCommand("copy");
      area.remove();
      return ok;
    };

    button.addEventListener("click", async () => {
      const value = text.textContent?.trim() ?? "";
      let ok = false;
      // A clipboard write that neither resolves nor rejects (a pending permission prompt)
      // must not leave the button silent: give it a second, then fall back.
      const timeout = new Promise<never>((_, reject) =>
        window.setTimeout(() => reject(new Error("clipboard timeout")), 1000),
      );
      try {
        await Promise.race([navigator.clipboard.writeText(value), timeout]);
        ok = true;
      } catch {
        ok = fallback(value);
      }
      button.textContent = ok ? "Copied" : "Selected";
      button.dataset.state = ok ? "done" : "failed";
      status.textContent = ok ? "Install command copied to clipboard." : "Copy failed. The command is selected; press your copy shortcut.";
      if (!ok) {
        const range = document.createRange();
        range.selectNodeContents(text);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = "Copy";
        delete button.dataset.state;
        status.textContent = "";
      }, 2000);
    });
  }
</script>
