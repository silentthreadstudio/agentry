---
// DocsSidebar.astro — the persistent grouped left nav for /docs, driven entirely
// by the typed docs-nav.ts source of truth. Overview link, then the three groups
// in reading order. The active item is marked by the `current` route key + aria-current.
//
// Desktop: a sticky rail. Mobile (< 900px): collapses behind a disclosure toggle (the
// co-located <script> below — reduced-motion-safe, no framework). Base-path rule: every
// href goes through withBase() or it 404s under /agentry.
import { withBase } from "../../lib/base.ts";
import { DOCS_OVERVIEW, type DocsKey, docsGroups } from "../../lib/docs-nav.ts";

interface Props {
  /** Active route key — omit on the overview index. */
  current?: DocsKey;
}
const { current } = Astro.props;
const onOverview = current === undefined;
---

<nav class="docsidebar" aria-label="Documentation">
  <button
    class="docsidebar__toggle"
    aria-expanded="false"
    aria-controls="docsidebar-panel"
  >
    <span class="docsidebar__toggle-label">Documentation</span>
    <span class="docsidebar__chev" aria-hidden="true">▾</span>
  </button>

  <div class="docsidebar__panel" id="docsidebar-panel">
    <a
      class:list={["docsidebar__overview", { "is-active": onOverview }]}
      href={withBase(DOCS_OVERVIEW.href)}
      aria-current={onOverview ? "page" : undefined}
    >
      {DOCS_OVERVIEW.label}
    </a>

    {
      docsGroups.map((group) => (
        <div class="docsidebar__group">
          <p class="docsidebar__grouptitle">{group.title}</p>
          <ul class="docsidebar__list" role="list">
            {group.items.map((item) => (
              <li>
                <a
                  href={withBase(item.href)}
                  class:list={["docsidebar__link", { "is-active": item.key === current }]}
                  aria-current={item.key === current ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</nav>

<style>
  /* desktop: a sticky rail beside the article */
  .docsidebar {
    position: sticky;
    top: 24px;
    align-self: start;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    padding: 4px 8px 4px 4px;
  }

  /* the mobile disclosure toggle is hidden on desktop */
  .docsidebar__toggle {
    display: none;
  }

  .docsidebar__overview,
  .docsidebar__link {
    display: flex;
    align-items: center;
    min-height: 36px;
    padding: 6px 12px;
    border-radius: var(--radius-s);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink-2);
    text-decoration: none;
  }

  .docsidebar__overview {
    margin-bottom: 18px;
  }

  .docsidebar__overview:hover,
  .docsidebar__link:hover {
    color: var(--ink);
    background: var(--surface);
  }

  .docsidebar__group {
    margin-bottom: 22px;
  }

  .docsidebar__grouptitle {
    padding: 0 12px;
    margin-bottom: 6px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .docsidebar__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* active item: an ink pill with the "one" signal bar, matching the landing's chips */
  .docsidebar__link.is-active,
  .docsidebar__overview.is-active {
    color: var(--ink);
    background: var(--surface);
    box-shadow: inset 0 0 0 2px var(--line), inset 6px 0 0 0 var(--one);
    padding-left: 16px;
  }

  /* mobile: collapse to a disclosure under a full-width toggle */
  @media (max-width: 900px) {
    .docsidebar {
      position: static;
      max-height: none;
      overflow: visible;
      margin-bottom: 16px;
      padding: 0;
    }

    .docsidebar__toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      min-height: 48px;
      padding: 0 16px;
      border: var(--border);
      border-radius: var(--radius-m);
      background: var(--surface);
      color: var(--ink);
      font-weight: 700;
      cursor: pointer;
    }

    .docsidebar__chev {
      transition: transform 0.2s ease;
    }

    .docsidebar__toggle[aria-expanded="true"] .docsidebar__chev {
      transform: rotate(180deg);
    }

    .docsidebar__panel {
      display: none;
      padding: 16px 0 4px;
    }

    .docsidebar__panel.is-open {
      display: block;
    }
  }
</style>

<script>
  // Co-located view-logic: the mobile disclosure toggle. No framework — one listener,
  // ARIA kept in sync, and it no-ops on desktop where the toggle is display:none.
  const toggle = document.querySelector<HTMLButtonElement>(".docsidebar__toggle");
  const panel = document.getElementById("docsidebar-panel");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    panel?.classList.toggle("is-open", !open);
  });
</script>
