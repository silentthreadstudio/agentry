#!/usr/bin/env node
// agentry — the one command the plugin puts on the Bash tool's PATH (a plugin's bin/ is on it while the
// plugin is enabled): `agentry board …` runs scripts/board.mjs, `agentry lane …` runs scripts/lane.mjs,
// `agentry mem …` runs scripts/mem.mjs, `agentry draft …` is `agentry board draft …`. The scripts run as
// they are, stdio inherited, so the output and exit codes are theirs. `agentry run …` and `agentry lock …`
// run in this process (scripts/lib/cli/run.mjs), so the pid a lock records is the one a `kill -9` of
// `agentry run` takes away. Node built-ins only.
import { spawnSync } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const PLUGIN = join(dirname(fileURLToPath(import.meta.url)), "..");
const SCRIPTS = { board: "board.mjs", lane: "lane.mjs", mem: "mem.mjs" };

const HELP = `usage: agentry <board|lane|mem|draft|lock> [<subcommand>] [--root <git root>] [--process <file>] [--help]
       agentry run --limit <dur> [--lock <name>] -- <cmd> [args…]
       agentry --version

groups:
  board   the repo's board: status, check, add, set, fix, ...    agentry board status
  lane    the lane steppers: exec, merge, session, sweep         agentry lane exec show T-4
  mem     the memory store: write, recall, search, stats, ...    agentry mem recall --query "..."
  draft   the owner's pending drafts (agentry board draft)       agentry draft list
  run     a command under a time limit, and a named lock          agentry run --limit 10m -- <cmd>
  lock    take, drop or show a named lock (workflow.json locks)   agentry lock show

agentry <group> --help lists a group's subcommands; agentry <group> <subcommand> --help prints its args,
flags, exit codes and an example. --process names the process file; the workflow file is its sibling
workflow.json.`;

const [group, ...rest] = process.argv.slice(2);
// The running build's version: plugin.json's, and in a git checkout what HEAD is past it (lib/cli/help.mjs).
const version = async () => {
  const help = await import(pathToFileURL(join(PLUGIN, "scripts", "lib", "cli", "help.mjs")).href);
  return help.pluginVersion(PLUGIN) ?? help.UNKNOWN_VERSION;
};

if (group === undefined || group === "--help" || group === "-h") {
  console.log(`${HELP}\n\nagentry plugin ${await version()}`);
} else if (group === "--version" || group === "-v") {
  console.log(await version());
} else if (group === "draft" || Object.hasOwn(SCRIPTS, group)) {
  const [script, args] =
    group === "draft" ? ["board.mjs", ["draft", ...rest]] : [SCRIPTS[group], rest];
  const run = spawnSync(process.execPath, [join(PLUGIN, "scripts", script), ...args], {
    stdio: "inherit",
  });
  if (run.error) {
    console.error(`✗ agentry ${group}: could not start ${script}: ${run.error.message} → node --version (Node 24+)`);
    process.exitCode = 2;
  } else if (run.signal) {
    console.error(`✗ agentry ${group}: ${script} was killed by ${run.signal}`);
    process.exitCode = 1;
  } else process.exitCode = run.status;
} else if (group === "run" || group === "lock") {
  const cli = await import(pathToFileURL(join(PLUGIN, "scripts", "lib", "cli", "run.mjs")).href);
  process.exitCode = await (group === "run" ? cli.runCli : cli.lockCli)(rest);
} else {
  console.error(`✗ agentry ${group}: unknown group (board, lane, mem, draft, run, lock) → agentry --help`);
  process.exitCode = 2;
}
