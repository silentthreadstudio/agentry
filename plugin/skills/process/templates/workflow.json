{
  "lifecycle": {
    "kind": "task",
    "on": { "dispatched": "doing", "built": "verify", "failed": "doing", "merged": "done" },
    "write": {
      "status": "status",
      "verdict": "verdict",
      "commit": "commit",
      "handoff": "parent.file:handoff"
    },
    "handoff": "- **{id}** ({sha}): {summary}"
  },
  "exec": {
    "kinds": {
      "debt": {
        "on": { "dispatched": "doing", "built": "verify", "failed": "doing", "merged": "done" },
        "write": { "status": "status", "verdict": "verdict", "commit": "commit" }
      }
    }
  },
  "drafts": {
    "decision": {
      "kind": "decision",
      "map": { "decision": "{answer}", "why": "{question}", "rejected": "{unpicked}" }
    }
  }
}
